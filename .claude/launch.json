{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "metro",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start"
      ],
      "port": 8081
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web"
      ],
      "port": 8081
    },
    {
      "name": "website",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4599",
        "--directory",
        "docs"
      ],
      "port": 4599
    }
  ]
}
